doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title みんなの晩ごはん掲示板
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    style.
      body {
        background-color: #fff8ee;
      }
      .navbar {
        background-color: #e06c2c;
      }
      .btn-orange {
        background-color: #e06c2c;
        color: white;
      }
      .btn-orange:hover {
        background-color: #c75a1f;
        color: white;
      }
      .category {
        background-color: #e06c2c;
      }
      .content {
        white-space: pre-wrap;
      }
  body
    nav.navbar.navbar-dark.mb-4
      .container
        span.navbar-brand みんなの晩ごはん掲示板
        span.text-white
          | #{user} さん
          a.btn.btn-sm.btn-light.ms-3(href="/logout") ログアウト
    .container(style="max-width: 700px;")
      .card.mb-4
        .card-body
          h5.card-title 今日の晩ごはんは？
          form(method="post" action="/posts")
            select.form-select.mb-2(name="category")
              each category in categories
                option(value=category) #{category}
            textarea.form-control.mb-2(name="content" rows="3" maxlength="200" placeholder="例：カレーライス")
            button.btn.btn-orange(type="submit") 投稿

      .mb-3
        a.btn.btn-sm.me-1.mb-1(href="/posts" class=(selected ? 'btn-outline-secondary' : 'btn-secondary')) すべて
        each category in categories
          a.btn.btn-sm.me-1.mb-1(href="/posts?category=" + category class=(selected === category ? 'btn-secondary' : 'btn-outline-secondary')) #{category}

      if posts.length === 0
        p.text-muted まだ投稿がありません
      each post in posts
        .card.mb-3
          .card-body
            p.mb-2
              span.badge.category.me-2 #{post.category}
              small.text-muted #{post.postedBy} さん・#{post.formattedCreatedAt}
            p.content.card-text #{post.content}
            .d-flex.gap-2
              form(method="post" action="/posts/like")
                input(type="hidden" name="id" value=post.id)
                if post.liked
                  button.btn.btn-sm.btn-danger(type="submit" disabled) ♥ #{post.likes}
                else
                  button.btn.btn-sm.btn-outline-danger(type="submit") ♡ #{post.likes}
              if user === post.postedBy || user === 'admin'
                form(method="post" action="/posts/delete")
                  input(type="hidden" name="id" value=post.id)
                  button.btn.btn-sm.btn-outline-secondary(type="submit") 削除
